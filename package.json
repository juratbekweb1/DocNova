    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
